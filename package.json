{
  "name": "voxelchat",
  "version": "2.0.0",
  "private": true,
  "description": "Chat with SmolLM2 1.7B on your own machine – zero setup, zero cloud, zero API keys.",
  "type": "module",
  "main": "src/launcher.js",
  "scripts": {
    "start": "node src/launcher.js",
    "dev": "node --watch src/launcher.js",
    "prepare-model": "node scripts/prepare-model.mjs",
    "test": "node scripts/api-test.mjs && node scripts/smoke-test.mjs",
    "test:api": "node scripts/api-test.mjs",
    "test:ui": "node scripts/smoke-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "llama",
    "smollm2",
    "node-llama-cpp",
    "local-llm",
    "offline",
    "chat"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "node-llama-cpp": "^3.22.3"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
